# Modèle d'environnement pour le test LOCAL (docker-compose.hiha.local.yml).
# Copier en `.env.hiha.local` (non versionné) et générer les secrets :
#   openssl rand -hex 32
# Aucun secret réel ne doit figurer dans ce fichier ni être commité.
# La configuration de production vit dans Coolify (variables d'environnement),
# jamais dans le dépôt.

# --- Site ---
LEARNHOUSE_SITE_NAME=HI-HA Campus (local)
LEARNHOUSE_ENV=dev
LEARNHOUSE_TENANCY=single

# --- Secrets (générer, ≥32 caractères) ---
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CHANGEME_openssl_rand_hex_32
COLLAB_INTERNAL_KEY=CHANGEME_openssl_rand_hex_32

# --- Bootstrap admin/org (auto-install au premier boot) ---
# PIÈGE VÉRIFIÉ : un email en .test / .local / .localhost est REJETÉ par
# email-validator (TLD réservé). L'organisation est alors créée SANS admin, et
# l'auto-install est sautée aux boots suivants → instance inutilisable.
# Utiliser un domaine réel ou .example.
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@hiha.example
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=CHANGEME
LEARNHOUSE_INITIAL_ORG_NAME=HI-HA
LEARNHOUSE_INITIAL_ORG_SLUG=hiha

# --- Domaine / CORS (localhost, port 80) ---
LEARNHOUSE_DOMAIN=localhost
LEARNHOUSE_FRONTEND_DOMAIN=localhost
LEARNHOUSE_SSL=false
LEARNHOUSE_ALLOWED_ORIGINS=http://localhost
# LEARNHOUSE_COOKIE_DOMAIN : ne pas définir en tenancy=single (cookies host-only).

# --- Base de données (service compose "db") ---
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=learnhouse
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:CHANGEME@db:5432/learnhouse

# --- Redis (service compose "redis") ---
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/0
LEARNHOUSE_REDIS_URL=redis://redis:6379/0

# --- Stockage contenu (volume monté sur /app/api/content) ---
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# --- Frontend (injecté au runtime par server-wrapper.js, pas au build) ---
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost/api/v1/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=hiha
NEXT_PUBLIC_LEARNHOUSE_HTTPS=false
NEXT_PUBLIC_COLLAB_URL=ws://localhost/collab
